# Chaîne de connexion Neon (Vercel > Storage > Neon, ou console Neon)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/cuizinote?sslmode=require

# Liste des courriels autorisés à créer un compte, séparés par des virgules.
# Laisser vide pour bloquer toute nouvelle inscription après la création de votre compte.
INSCRIPTIONS_AUTORISEES=vous@exemple.com

# IA gratuite : clé Google Gemini (https://aistudio.google.com/apikey) - offre gratuite
GEMINI_API_KEY=
GEMINI_MODELE=gemini-flash-latest

# Code à partager pour permettre une inscription avec n'importe quel courriel (8 caractères minimum)
CODE_INVITATION=
